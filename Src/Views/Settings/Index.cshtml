@model ProposalIQ.Web.Models.SettingsViewModel
@{
    ViewData["Title"] = "AI Provider Settings";
}

<div class="container py-4" style="max-width: 860px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">AI Provider Configuration</h1>
            <p class="text-secondary mb-0">Manage active AI providers, models, endpoints, and credentials.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Analyzer
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@Model.SuccessMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-4 d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5 flex-shrink-0 mt-1"></i>
            <div>
                <strong class="d-block mb-1">Please correct the following errors:</strong>
                <ul class="mb-0 ps-3">
                    @foreach (var state in ViewData.ModelState.Values)
                    {
                        foreach (var error in state.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
        </div>
    }

    <form asp-controller="Settings" asp-action="Index" method="post" id="settingsForm">
        @Html.AntiForgeryToken()

        <!-- Active Provider Selection -->
        <div class="card rounded-4 border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold mb-3">Active AI Provider</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-check p-3 border rounded-4 @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.FoundryLocal ? "border-primary bg-primary-subtle" : "")">
                            <input class="form-check-input" type="radio" asp-for="ActiveProvider" value="FoundryLocal" id="providerFoundryLocal">
                            <label class="form-check-label fw-semibold" for="providerFoundryLocal">
                                <i class="bi bi-cpu text-primary me-1"></i> Foundry Local
                                <div class="small fw-normal text-secondary mt-1">Runs locally via on-device AI runtime</div>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check p-3 border rounded-4 @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.OpenRouter ? "border-primary bg-primary-subtle" : "")">
                            <input class="form-check-input" type="radio" asp-for="ActiveProvider" value="OpenRouter" id="providerOpenRouter">
                            <label class="form-check-label fw-semibold" for="providerOpenRouter">
                                <i class="bi bi-clouds text-info me-1"></i> OpenRouter
                                <div class="small fw-normal text-secondary mt-1">Multi-model cloud API routing</div>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check p-3 border rounded-4 @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.OpenAI ? "border-primary bg-primary-subtle" : "")">
                            <input class="form-check-input" type="radio" asp-for="ActiveProvider" value="OpenAI" id="providerOpenAI">
                            <label class="form-check-label fw-semibold" for="providerOpenAI">
                                <i class="bi bi-lightning-charge text-success me-1"></i> OpenAI
                                <div class="small fw-normal text-secondary mt-1">Direct OpenAI API integration</div>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check p-3 border rounded-4 @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.AzureOpenAI ? "border-primary bg-primary-subtle" : "")">
                            <input class="form-check-input" type="radio" asp-for="ActiveProvider" value="AzureOpenAI" id="providerAzureOpenAI">
                            <label class="form-check-label fw-semibold" for="providerAzureOpenAI">
                                <i class="bi bi-microsoft text-primary me-1"></i> Azure OpenAI
                                <div class="small fw-normal text-secondary mt-1">Enterprise Azure OpenAI Service</div>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check p-3 border rounded-4 @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.Local ? "border-primary bg-primary-subtle" : "")">
                            <input class="form-check-input" type="radio" asp-for="ActiveProvider" value="Local" id="providerLocal">
                            <label class="form-check-label fw-semibold" for="providerLocal">
                                <i class="bi bi-hdd-network text-warning me-1"></i> Local (HTTP)
                                <div class="small fw-normal text-secondary mt-1">OpenAI-compatible server (Ollama, vLLM)</div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Foundry Local Configuration Panel -->
        <div id="sectionFoundryLocal" class="card rounded-4 border-0 shadow-sm mb-4 provider-section @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.FoundryLocal ? "" : "d-none")">
            <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-3"><i class="bi bi-cpu text-primary me-1"></i> Foundry Local Settings</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FoundryLocal.ModelAlias" class="form-label fw-semibold">Model Alias</label>
                        <input asp-for="FoundryLocal.ModelAlias" class="form-control" placeholder="e.g. qwen2.5-0.5b or phi-3.5-mini" />
                        <div class="form-text">Alias in the Foundry Local catalog to download and execute.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FoundryLocal.AppName" class="form-label fw-semibold">App Name</label>
                        <input asp-for="FoundryLocal.AppName" class="form-control" placeholder="ProposalIQ" />
                        <div class="form-text">Application name used for cache identification.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- OpenRouter Configuration Panel -->
        <div id="sectionOpenRouter" class="card rounded-4 border-0 shadow-sm mb-4 provider-section @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.OpenRouter ? "" : "d-none")">
            <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-3"><i class="bi bi-clouds text-info me-1"></i> OpenRouter Settings</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OpenRouter.Model" class="form-label fw-semibold">Model</label>
                        <input asp-for="OpenRouter.Model" class="form-control" placeholder="openrouter/auto" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OpenRouter.Endpoint" class="form-label fw-semibold">Endpoint</label>
                        <input asp-for="OpenRouter.Endpoint" class="form-control" placeholder="https://openrouter.ai/api/v1/" />
                    </div>
                    <div class="col-12">
                        <label asp-for="OpenRouter.ApiKey" class="form-label fw-semibold">API Key</label>
                        <input type="password" asp-for="OpenRouter.ApiKey" class="form-control" placeholder="@(Model.HasOpenRouterApiKey ? "●●●●●●●● (Stored - leave blank to keep unchanged)" : "sk-or-v1-...")" />
                    </div>
                </div>
            </div>
        </div>

        <!-- OpenAI Configuration Panel -->
        <div id="sectionOpenAI" class="card rounded-4 border-0 shadow-sm mb-4 provider-section @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.OpenAI ? "" : "d-none")">
            <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-3"><i class="bi bi-lightning-charge text-success me-1"></i> OpenAI Settings</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OpenAI.Model" class="form-label fw-semibold">Model</label>
                        <input asp-for="OpenAI.Model" class="form-control" placeholder="gpt-4o-mini" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OpenAI.ApiKey" class="form-label fw-semibold">API Key</label>
                        <input type="password" asp-for="OpenAI.ApiKey" class="form-control" placeholder="@(Model.HasOpenAiApiKey ? "●●●●●●●● (Stored - leave blank to keep unchanged)" : "sk-proj-...")" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Azure OpenAI Configuration Panel -->
        <div id="sectionAzureOpenAI" class="card rounded-4 border-0 shadow-sm mb-4 provider-section @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.AzureOpenAI ? "" : "d-none")">
            <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-3"><i class="bi bi-microsoft text-primary me-1"></i> Azure OpenAI Settings</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AzureOpenAI.Endpoint" class="form-label fw-semibold">Endpoint URL</label>
                        <input asp-for="AzureOpenAI.Endpoint" class="form-control" placeholder="https://myresource.openai.azure.com/" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AzureOpenAI.Deployment" class="form-label fw-semibold">Deployment Name</label>
                        <input asp-for="AzureOpenAI.Deployment" class="form-control" placeholder="gpt-4o-mini" />
                    </div>
                    <div class="col-12">
                        <label asp-for="AzureOpenAI.ApiKey" class="form-label fw-semibold">API Key</label>
                        <input type="password" asp-for="AzureOpenAI.ApiKey" class="form-control" placeholder="@(Model.HasAzureOpenAiApiKey ? "●●●●●●●● (Stored - leave blank to keep unchanged)" : "Azure API key")" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Local (HTTP) Configuration Panel -->
        <div id="sectionLocal" class="card rounded-4 border-0 shadow-sm mb-4 provider-section @(Model.ActiveProvider == ProposalIQ.Web.Configuration.AiProvider.Local ? "" : "d-none")">
            <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-3"><i class="bi bi-hdd-network text-warning me-1"></i> Local OpenAI-Compatible Server</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Local.Model" class="form-label fw-semibold">Model Name</label>
                        <input asp-for="Local.Model" class="form-control" placeholder="llama3 or mistral" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Local.Endpoint" class="form-label fw-semibold">Server Endpoint</label>
                        <input asp-for="Local.Endpoint" class="form-control" placeholder="http://localhost:11434/v1/" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mb-5">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-save me-1"></i> Save Configuration
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radioButtons = document.querySelectorAll('input[name="ActiveProvider"]');
            const sections = {
                "FoundryLocal": document.getElementById("sectionFoundryLocal"),
                "OpenRouter": document.getElementById("sectionOpenRouter"),
                "OpenAI": document.getElementById("sectionOpenAI"),
                "AzureOpenAI": document.getElementById("sectionAzureOpenAI"),
                "Local": document.getElementById("sectionLocal")
            };

            function updateVisibleSection(provider) {
                Object.keys(sections).forEach(key => {
                    const section = sections[key];
                    if (section) {
                        if (key === provider) {
                            section.classList.remove("d-none");
                        } else {
                            section.classList.add("d-none");
                        }
                    }
                });

                radioButtons.forEach(radio => {
                    const parentCard = radio.closest(".form-check");
                    if (parentCard) {
                        if (radio.value === provider) {
                            parentCard.classList.add("border-primary", "bg-primary-subtle");
                        } else {
                            parentCard.classList.remove("border-primary", "bg-primary-subtle");
                        }
                    }
                });
            }

            radioButtons.forEach(radio => {
                radio.addEventListener("change", function () {
                    updateVisibleSection(this.value);
                });
            });
        });
    </script>
}
